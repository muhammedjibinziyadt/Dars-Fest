# ==========================================
# FIREBASE CONFIGURATION
# ==========================================

# 1. Firebase Admin SDK (Server Side)
# Generated in Firebase Console: Project Settings > Service Accounts > "Generate new private key"
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Note: Keep the quotes around the private key, replace newlines with \n if single line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# 2. Firebase Client SDK (Browser / Client Side)
# Found in Firebase Console: Project Settings > General > "Your apps" > Web App (</>)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==========================================
# APP SETTINGS
# ==========================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ==========================================
# AI CHATBOT (Optional)
# ==========================================
GEMINI_API_KEY=
